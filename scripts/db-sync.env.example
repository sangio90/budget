# Configurazione per scripts/db-backup.sh.
# Copia questo file in scripts/db-sync.env (ignorato da git) e compila i valori.

# Server di produzione, nella forma utente@host usata da ssh/scp.
PROD_SSH=forge@gslabs.it

# Database di produzione (gli stessi valori del .env sul server).
PROD_DB_HOST=127.0.0.1
PROD_DB_PORT=3306
PROD_DB_DATABASE=budget
PROD_DB_USERNAME=forge
PROD_DB_PASSWORD=

# Cartella locale dove salvare i backup (default: backups/ nel progetto).
#BACKUP_DIR=
